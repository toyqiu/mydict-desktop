{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面窗口的最小权限集：窗口显隐/聚焦/拖动 + 全局热键插件。自定义命令不需要在这里声明。viewer 是全屏图片查看器窗口。",
  "platforms": [
    "linux",
    "windows",
    "macOS"
  ],
  "windows": [
    "main",
    "popup",
    "viewer"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "global-shortcut:default"
  ]
}