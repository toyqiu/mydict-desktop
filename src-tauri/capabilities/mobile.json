{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile",
  "description": "Android/iOS 单窗口的最小权限集。桌面专属权限（全局热键、窗口拖动区）在移动端不存在，不能引用。自定义命令不需要在这里声明。",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:default"
  ]
}
